rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isGoogle() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function famPath(fid) { return /databases/$(database)/documents/families/$(fid); }
    function isParent(fid) { return isGoogle() && request.auth.uid in get(famPath(fid)).data.parentUids; }
    function isKid(fid, kid) {
      return signedIn() && get(/databases/$(database)/documents/families/$(fid)/kids/$(kid)).data.kidUid == request.auth.uid;
    }
    // a child account of this family: its sign-in address ends with __<family code>@kid.talantfoxes.app
    function isFamilyKid(fid) {
      return signedIn() && !isGoogle() && request.auth.token.email != null
        && request.auth.token.email.matches('.*__' + get(famPath(fid)).data.inviteCode + '@kid\\.talantfoxes\\.app');
    }
    function onlyStatusChanges() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']); }

    // invite code -> family id; used by a second parent to join and by a child to find the family
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if isGoogle() && request.auth.uid in getAfter(famPath(request.resource.data.fid)).data.parentUids;
      allow update: if false;
      allow delete: if isGoogle() && request.auth.uid in get(famPath(resource.data.fid)).data.parentUids;
    }

    // login name -> auth version, readable before sign-in so a child can build the sign-in address
    match /logins/{id} {
      allow get: if true;
      allow create, update: if isGoogle() && request.auth.uid in getAfter(famPath(request.resource.data.fid)).data.parentUids;
      allow delete: if isGoogle() && request.auth.uid in get(famPath(resource.data.fid)).data.parentUids;
    }

    match /families/{fid} {
      allow read: if isGoogle() && request.auth.uid in resource.data.parentUids;
      allow create: if isGoogle()
        && request.resource.data.parentUids == [request.auth.uid]
        && request.resource.data.keys().hasOnly(['name', 'parentUids', 'inviteCode', 'createdAt', 'consent']);
      allow update: if isGoogle() && (
        (request.auth.uid in resource.data.parentUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']))
        ||
        // a parent leaves the family: removes only their own id
        (request.auth.uid in resource.data.parentUids
          && !(request.auth.uid in request.resource.data.parentUids)
          && resource.data.parentUids.hasAll(request.resource.data.parentUids)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentUids']))
        ||
        (request.auth.uid in request.resource.data.parentUids
          && request.resource.data.parentUids.hasAll(resource.data.parentUids)
          && request.resource.data.parentUids.size() <= 2
          && request.resource.data.joinProof == resource.data.inviteCode
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentUids', 'joinProof']))
      );

      // family rules and the family pot: parents write, the family's children read
      allow delete: if isGoogle() && request.auth.uid in resource.data.parentUids;

      match /shared/{doc} {
        allow read: if isParent(fid) || isFamilyKid(fid);
        allow write: if isParent(fid);
      }

      match /kids/{kid} {
        allow read: if isParent(fid) || (signedIn() && resource.data.kidUid == request.auth.uid);
        allow create, delete: if isParent(fid);
        allow update: if isParent(fid)
          || (signedIn() && resource.data.kidUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accent', 'pet']));

        // task submissions, bonuses and approvals
        match /log/{id} {
          allow read: if isParent(fid) || isKid(fid, kid);
          allow create: if isParent(fid)
            || (isKid(fid, kid) && request.resource.data.status == 'pending' && request.resource.data.type == 'task');
          allow update: if isParent(fid) && onlyStatusChanges();
          allow delete: if isParent(fid);
        }

        // reward and wardrobe purchases
        match /orders/{id} {
          allow read: if isParent(fid) || isKid(fid, kid);
          allow create: if isParent(fid)
            || (isKid(fid, kid) && request.resource.data.status in ['pending', 'auto']);
          allow update: if isParent(fid) && onlyStatusChanges();
          allow delete: if isParent(fid);
        }
      }
    }
  }
}
